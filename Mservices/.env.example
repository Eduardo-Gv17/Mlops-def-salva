# ════════════════════════════════════════════════════
#  MLOps Lite — Variables de entorno
#  Copia este archivo: cp .env.example .env
#  Luego rellena los valores reales en .env
#  ¡NUNCA subas el .env al repositorio!
# ════════════════════════════════════════════════════

# ── Features DB (PostgreSQL en MV3) ──
FEATURES_DB_HOST=<IP_PRIVADA_MV3>
FEATURES_DB_PORT=5432
FEATURES_DB_USER=mlops_user
FEATURES_DB_PASSWORD=<tu_password_postgres>
FEATURES_DB_NAME=features_db

# ── Models DB (MySQL en MV3) ──
MODELS_DB_HOST=<IP_PRIVADA_MV3>
MODELS_DB_PORT=3306
MODELS_DB_ROOT_PASSWORD=<tu_root_password_mysql>
MODELS_DB_NAME=models_db
MODELS_DB_USER=mlops_user
MODELS_DB_PASSWORD=<tu_password_mysql>

# ── PredLogs DB (MongoDB en MV3) ──
PREDLOGS_DB_HOST=<IP_PRIVADA_MV3>
PREDLOGS_DB_PORT=27017
PREDLOGS_DB_NAME=predlogs_db

# ── Inter-service URLs (apuntan a la misma VM en EC2) ──
# En EC2 usar la IP privada de la misma MV (o localhost si están en la misma docker network)
MODELS_SERVICE_URL=http://ms2-models:8002
PREDLOGS_SERVICE_URL=http://ms3-predlogs:8003

# ── AWS Academy (se renuevan cada 4 horas) ──
AWS_ACCESS_KEY_ID=<tu_access_key_id>
AWS_SECRET_ACCESS_KEY=<tu_secret_access_key>
AWS_SESSION_TOKEN=<tu_session_token>
AWS_REGION=us-east-1

# ── Athena / S3 ──
ATHENA_DATABASE=mlops_analytics
ATHENA_OUTPUT_LOCATION=s3://mlops-analytics-oswaldoaqm/athena-results/
S3_BUCKET=mlops-analytics-oswaldoaqm
